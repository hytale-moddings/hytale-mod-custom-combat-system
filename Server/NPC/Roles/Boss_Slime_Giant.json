    {
      "$Comment": "=== COMBAT BLOCK 1: BodyMotion per state ===",
      "Continue": true,
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": "Idle"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Player",
                "Range": 20
              },
              "HeadMotion": {
                "Type": "Watch"
              },
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "BodyMotion": {
                "Type": "Wander",
                "MaxHeadingChange": 45,
                "RelativeSpeed": 0.3
              }
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": "Combat"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Player",
                "Range": 30
              },
              "BodyMotion": {
                "Type": "MaintainDistance",
                "DesiredDistanceRange": [1.5, 3.5],
                "MoveThreshold": 0.5,
                "RelativeForwardsSpeed": 0.6,
                "RelativeBackwardsSpeed": 0.5,
                "StrafingDurationRange": [1, 1],
                "StrafingFrequencyRange": [2, 2]
              }
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "BodyMotion": {
                "Type": "Nothing"
              }
            }
          ]
        }
      ]
    },
    {
      "$Comment": "=== COMBAT BLOCK 2: Actions and state transitions ===",
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": "Idle"
          },
          "Instructions": [
            {
              "$Comment": "React to damage - enter combat",
              "Sensor": {
                "Type": "Damage"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "Combat"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "Nothing"
                }
              ]
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": "Combat"
          },
          "Instructions": [
            {
              "$Comment": "Attack when player is close",
              "Sensor": {
                "Type": "Player",
                "Range": 14
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "Attack",
                  "Attack": "Root_NPC_Attack_Melee",
                  "AttackPauseRange": [1.0, 2.0]
                },
                {
                  "Type": "Timeout",
                  "Delay": [0.2, 0.2]
                }
              ],
              "HeadMotion": {
                "Type": "Aim",
                "RelativeTurnSpeed": 1.5
              }
            },
            {
              "$Comment": "Return to idle if no player nearby",
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "Player",
                  "Range": 40
                }
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "Idle"
                }
              ]
            }
          ]
        }
      ]
    }
